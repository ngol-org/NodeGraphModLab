<Project Sdk="Microsoft.NET.Sdk">

  <!--
    「自作.NETアプリへのNGOL組み込み」サンプル。
    展開済みリリースzipの NGOL/ フォルダから setup-ngol-embed-sample.ps1 で
    ngol-resources/ を組み立てておくと、ビルド時に実行ファイルの隣へコピーされる。
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>NgolEmbedSample</AssemblyName>
    <RootNamespace>NgolEmbedSample</RootNamespace>
    <!-- Roslyn の多言語リソースは出力に含めない。en は既定でフォルダを作らない。 -->
    <SatelliteResourceLanguages>en;ja</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!--
      NGOL を通常のライブラリとして参照する。既定の CopyLocal により DLL が自身の出力へ
      コピーされるので、実行時に読む DLL とビルド時に参照した DLL が常に同一になる。
      NuGet パッケージや DLL への <Reference> に置き換えてもそのまま動く。
    -->
    <ProjectReference Include="..\..\NodeGraphModLab.Core\NodeGraphModLab.Core.csproj" />
    <ProjectReference Include="..\..\NodeGraphModLab.NodeAPI\NodeGraphModLab.NodeAPI.csproj" />
    <ProjectReference Include="..\..\NodeGraphModLab.HostLogging\NodeGraphModLab.HostLogging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ngol-resources/ 配下の .cs は NGOL が実行時に読むノードソース。
         このアプリ自体のコンパイル対象ではない。 -->
    <Compile Remove="ngol-resources\**" />
    <EmbeddedResource Remove="ngol-resources\**" />
    <None Remove="ngol-resources\**" />

    <!-- NGOLリソースを実行ファイルの隣へ配置する。実アプリでも同梱の形は同じ。 -->
    <Content Include="ngol-resources\**" CopyToOutputDirectory="PreserveNewest" LinkBase="ngol-resources" />
  </ItemGroup>

</Project>
